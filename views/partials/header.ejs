<%- include('head') %>
<div class="topbar"><div class="wrap">
  <span class="hide-sm">Cockatoo Island, Sydney Harbour · Dry storage from $547/month</span>
  <span><a href="tel:<%= biz.phone.replace(/\s|\(|\)/g,'') %>">Call <%= biz.phone %></a>&nbsp;&nbsp;·&nbsp;&nbsp;<% if (user) { %><a href="<%= user.role === 'customer' ? '/portal' : '/admin' %>"><%= user.role === 'customer' ? 'My account' : 'Staff admin' %></a><% } else { %><a href="/login">Sign in</a><% } %></span>
</div></div>
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/" aria-label="Cockatoo Marine home"><img src="/static/img/logo-240.png" alt="Cockatoo Marine" width="80" height="56"></a>
    <button class="navtoggle" aria-expanded="false" aria-controls="mainnav" onclick="const n=document.getElementById('mainnav');n.classList.toggle('open');this.setAttribute('aria-expanded',n.classList.contains('open'))">Menu</button>
    <nav class="mainnav" id="mainnav" aria-label="Main">
      <% for (const [href, label] of [['/service-antifoul','Service | Antifoul'],['/dry-boat-storage','Dry Boat Storage'],['/marina','Marina'],['/commercial-berths','Commercial Berths'],['/barging','Barging'],['/events','Events'],['/enquiry','Enquiry']]) { %>
        <a href="<%= href %>" <%- path === href ? 'aria-current="page"' : '' %>><%= label %></a>
      <% } %>
      <a class="btn btn-primary btn-sm" href="/book" onclick="track('quote_started',{location:'header'})">Get a storage quote</a>
    </nav>
  </div>
</header>
<main id="main">
